{
    "name": "rssoftbd/laravel-qr-code",
    "description": "QR Code Generator for Laravel",
    "keywords": ["qrcode", "laravel", "generator"],
    "license": "MIT",
    "authors": [
        {
            "name": "RSSoftBD",
            "email": "contact@rssoftbd.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-gd": "*",
        "bacon/bacon-qr-code": "^3.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "RSSoftBD\\QrCode\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RSSoftBD\\QrCode\\QrCodeServiceProvider"
            ],
            "aliases": {
                "QrCode": "RSSoftBD\\QrCode\\Facades\\QrCode"
            }
        }
    }
}
